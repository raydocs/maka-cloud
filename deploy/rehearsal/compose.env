# What Compose substitutes into deploy/compose.yaml for the rehearsal (see deploy/rehearsal/README.md).
MAKA_CLOUD_APP_NAME=app.localhost
MAKA_CLOUD_MCP_NAME=mcp.localhost
MAKA_CLOUD_MODELS_NAME=models.localhost
# Caddy's own certificate authority instead of a public one; the flow trusts its root.
MAKA_CLOUD_CADDY_GLOBAL=local_certs
