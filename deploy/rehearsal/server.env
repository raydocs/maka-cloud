# The server's settings for the rehearsal: fake keys, and the stand-ins from deploy/rehearsal/stubs.mjs
# for the model API and the sandbox API. up.sh runs "maka-cloud setup --from-env" on this file, which
# keeps these and adds the rest (the owner's invite and its sandbox, the public URLs, Web Push). Nothing
# here is a secret and nothing here reaches a real service.
ANTHROPIC_API_KEY=sk-ant-rehearsal-not-a-key
ANTHROPIC_BASE_URL=http://stubs:9101
INSTABOX_API_KEY=ibk_rehearsal
INSTABOX_API_URL=http://stubs:9100
MAKA_CLOUD_MCP_PUBLIC_URL=https://mcp.localhost/mcp
MAKA_CLOUD_GATEWAY_PUBLIC_URL=https://models.localhost
# The agent account of the sandbox stand-in (the rehearsal-sandbox image): the CLIs run as it, and the
# server keeps the channel to them for itself.
MAKA_CLOUD_AGENT_USER=maka-agent
MAKA_CLOUD_AGENT_GROUP=maka-box
# No model checks finished work: the stand-in model is not one that can. Setup keeps this choice.
MAKA_CLOUD_VERIFIER_MODELS='[]'
