{
  "name": "@maka-cloud/orchestrator",
  "version": "0.1.0",
  "description": "Orchestration MCP server: delegate_task, task_status, task_wait and task_cancel over an append-only task log.",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "clean": "node ../../scripts/clean-paths.mjs dist tsconfig.tsbuildinfo",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:dist": "node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.0",
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.0"
  }
}
