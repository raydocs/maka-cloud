{
  "name": "@maka-cloud/superagent-device",
  "version": "0.1.0",
  "description": "BYOM device daemon: dials out to Super-agent, registers capabilities, runs allowlisted commands in a workspace jail. Default off on the cloud side.",
  "type": "module",
  "private": true,
  "bin": {
    "maka-device": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "clean": "node ../../scripts/clean-paths.mjs dist tsconfig.tsbuildinfo",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:dist": "node --test --test-concurrency=1 \"dist/**/*.test.js\"",
    "start": "node ./dist/cli.js"
  },
  "dependencies": {
    "@maka-cloud/superagent": "0.1.0"
  }
}
