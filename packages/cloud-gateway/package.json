{
  "name": "@maka-cloud/gateway",
  "version": "0.1.0",
  "description": "Host-side model gateway: per-task revocable tokens bound to a budget, worst-case reservation before every model request, metering from the vendor's reported usage.",
  "type": "module",
  "private": true,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "clean": "node ../../scripts/clean-paths.mjs dist tsconfig.tsbuildinfo",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:dist": "node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@maka-cloud/orchestrator": "0.1.0"
  }
}
