{
  "name": "@maka-cloud/boxes",
  "version": "0.1.0",
  "description": "A pool of labelled instabox sandboxes per invite: one task per box, sleep and wake, setup snapshots.",
  "type": "module",
  "private": true,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./testing": {
      "types": "./dist/__tests__/fake-fleet.d.ts",
      "default": "./dist/__tests__/fake-fleet.js"
    }
  },
  "scripts": {
    "clean": "node ../../scripts/clean-paths.mjs dist tsconfig.tsbuildinfo",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:dist": "node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@maka-cloud/instabox": "0.1.0",
    "@maka-cloud/orchestrator": "0.1.0",
    "@maka-cloud/runners": "0.1.0"
  }
}
