{
  "name": "@maka-cloud/runners",
  "version": "0.1.0",
  "description": "Runners that drive the Claude Agent SDK CLI and Codex inside an instabox sandbox.",
  "type": "module",
  "private": true,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "clean": "node ../../scripts/clean-paths.mjs dist tsconfig.tsbuildinfo",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:dist": "node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@maka-cloud/instabox": "0.1.0",
    "@maka-cloud/orchestrator": "0.1.0"
  }
}
