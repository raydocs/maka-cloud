{
  "name": "@maka-cloud/instabox",
  "version": "0.1.0",
  "description": "WorkspaceExecutor that runs Maka's built-in tools inside an instabox sandbox.",
  "type": "module",
  "private": true,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./testing": {
      "types": "./dist/__tests__/fake-instabox.d.ts",
      "default": "./dist/__tests__/fake-instabox.js"
    }
  },
  "scripts": {
    "clean": "node ../../scripts/clean-paths.mjs dist tsconfig.tsbuildinfo",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:dist": "node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@maka/core": "0.1.0",
    "@maka/runtime": "0.1.0",
    "minimatch": "^10.0.1"
  }
}
