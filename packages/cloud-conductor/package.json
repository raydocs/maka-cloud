{
  "name": "@maka-cloud/conductor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The conductor: a Maka runtime agent that turns one user message into a checked playbook run.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./testing/fake-model": "./dist/__tests__/fake-model.js"
  },
  "scripts": {
    "clean": "node ../../scripts/clean-paths.mjs dist tsconfig.tsbuildinfo",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:dist": "node --test --test-concurrency=1 \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@maka-cloud/modes": "0.1.0",
    "@maka/core": "0.1.0",
    "@maka/runtime": "0.1.0",
    "@maka/storage": "0.1.0",
    "@modelcontextprotocol/client": "2.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@maka-cloud/conductor-checks": "0.1.0",
    "@maka-cloud/orchestrator": "0.1.0"
  }
}
