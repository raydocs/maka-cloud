{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maka.cloud/superagent.rules.schema.json",
  "title": "Super-agent routing rules",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "rules"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "rules": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "source": {
      "type": "string",
      "enum": ["github", "chat", "timer", "internal"]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._-]*$",
          "maxLength": 80
        },
        "match": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "oneOf": [
                { "$ref": "#/$defs/source" },
                {
                  "type": "array",
                  "minItems": 1,
                  "items": { "$ref": "#/$defs/source" }
                }
              ]
            },
            "type": {
              "oneOf": [
                { "type": "string", "minLength": 1 },
                {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1 }
                }
              ]
            },
            "object": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": { "type": "string", "minLength": 1 },
                "id": { "type": "string", "minLength": 1 },
                "repo": { "type": "string", "minLength": 1 }
              }
            },
            "tags": {
              "type": "array",
              "maxItems": 32,
              "items": { "type": "string", "minLength": 1 }
            },
            "paths": {
              "type": "array",
              "maxItems": 32,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "model": { "type": "string", "minLength": 1, "maxLength": 120 },
        "reasoning": { "type": "string", "enum": ["low", "medium", "high"] },
        "skills": {
          "type": "array",
          "maxItems": 16,
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        },
        "oneRunPerObject": { "type": "boolean" },
        "maxParallel": { "type": "integer", "minimum": 1, "maximum": 32 },
        "notifyHuman": { "type": "string", "enum": ["never", "on_ask", "always"] },
        "intensity": { "type": "string", "enum": ["observe", "act"] }
      }
    }
  }
}
