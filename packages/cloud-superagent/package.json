{
  "name": "@maka-cloud/superagent",
  "version": "0.1.0",
  "description": "Super-agent core: event intake, subscription pass-through, Router, persistent workers, watchdog, WorkspaceStore and safety hooks.",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "clean": "node ../../scripts/clean-paths.mjs dist tsconfig.tsbuildinfo",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:dist": "node --test --test-concurrency=1 \"dist/**/*.test.js\"",
    "workspace-bench": "node ./scripts/workspace-bench.mjs",
    "local-loop": "node ./scripts/local-loop.mjs",
    "live-smoke": "node ./scripts/live-smoke.mjs",
    "real-loop": "node ./scripts/real-loop.mjs",
    "metrics": "node ./scripts/metrics.mjs",
    "status": "node ./scripts/status.mjs"
  },
  "dependencies": {
    "@maka-cloud/orchestrator": "0.1.0",
    "zod": "^4.6.5"
  }
}
