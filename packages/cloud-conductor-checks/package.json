{
  "name": "@maka-cloud/conductor-checks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Checks that Maka's Anthropic model path keeps Claude conversation history append-only.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": "./dist/index.js",
  "scripts": {
    "clean": "node ../../scripts/clean-paths.mjs dist tsconfig.tsbuildinfo",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "report": "node dist/cli.js",
    "test:dist": "node --test --test-concurrency=1 \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@maka/core": "0.1.0",
    "@maka/runtime": "0.1.0",
    "@maka/storage": "0.1.0",
    "zod": "^4.6.5"
  }
}
