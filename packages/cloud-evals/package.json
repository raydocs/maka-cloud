{
  "name": "@maka-cloud/evals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Benchmark harness: Claude Agent SDK alone, Codex alone and the coding playbook on a SWE-bench Verified subset, with cost and resolve rate per task.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "cloud-evals": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "node ../../scripts/clean-paths.mjs dist tsconfig.tsbuildinfo",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:dist": "node --test --test-concurrency=1 \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@maka-cloud/orchestrator": "0.1.0",
    "@maka-cloud/playbooks": "0.1.0",
    "@maka-cloud/runners": "0.1.0",
    "@maka/eval": "0.1.0"
  }
}
