{
  "name": "@maka-cloud/playbooks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Playbooks for the conductor: the research playbook and its citation checker, and the coding playbook and its runner.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "cite-check": "./dist/research/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./citations": {
      "types": "./dist/citations.d.ts",
      "default": "./dist/citations.js"
    },
    "./coding": {
      "types": "./dist/coding/index.d.ts",
      "default": "./dist/coding/index.js"
    },
    "./sandbox-tool": {
      "types": "./dist/sandbox-tool.d.ts",
      "default": "./dist/sandbox-tool.js"
    }
  },
  "scripts": {
    "clean": "node ../../scripts/clean-paths.mjs dist tsconfig.tsbuildinfo",
    "build": "tsc -p tsconfig.json && esbuild src/research/cli.ts --bundle --platform=node --format=esm --target=node20 --minify --outfile=dist/cite-check.mjs && esbuild src/web-search/cli.ts --bundle --platform=node --format=esm --target=node20 --minify --outfile=dist/web-search.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:dist": "node --test --test-concurrency=1 \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@maka-cloud/conductor": "0.1.0",
    "@maka-cloud/modes": "0.1.0",
    "@maka-cloud/orchestrator": "0.1.0",
    "@maka-cloud/runners": "0.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@maka-cloud/instabox": "0.1.0"
  }
}
