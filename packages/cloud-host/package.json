{
  "name": "@maka-cloud/host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Runs the cloud server with the conductor as its conversation handler and the fork's playbooks.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": "./dist/index.js",
  "scripts": {
    "clean": "node ../../scripts/clean-paths.mjs dist tsconfig.tsbuildinfo",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:dist": "node --test --test-concurrency=1 \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@maka-cloud/conductor": "0.1.0",
    "@maka-cloud/orchestrator": "0.1.0",
    "@maka-cloud/playbooks": "0.1.0",
    "@maka-cloud/server": "0.1.0"
  },
  "devDependencies": {
    "@maka-cloud/conductor-checks": "0.1.0"
  }
}
