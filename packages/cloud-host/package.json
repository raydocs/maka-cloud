{
  "name": "@maka-cloud/host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Runs the cloud server with the conductor as its conversation handler and the fork's playbooks.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": "./dist/index.js",
  "bin": {
    "maka-cloud": "./dist/cli.js"
  },
  "scripts": {
    "clean": "node ../../scripts/clean-paths.mjs dist tsconfig.tsbuildinfo",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:dist": "node --test --test-concurrency=1 \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.82",
    "@ai-sdk/openai": "4.0.96",
    "@maka-cloud/conductor": "0.1.0",
    "@maka-cloud/duties": "0.1.0",
    "@maka-cloud/gateway": "0.1.0",
    "@maka-cloud/modes": "0.1.0",
    "@maka-cloud/orchestrator": "0.1.0",
    "@maka-cloud/playbooks": "0.1.0",
    "@maka-cloud/runners": "0.1.0",
    "@maka-cloud/server": "0.1.0",
    "@maka-cloud/supervisor": "0.1.0",
    "ai": "7.0.143"
  },
  "devDependencies": {
    "@maka-cloud/conductor-checks": "0.1.0"
  }
}
